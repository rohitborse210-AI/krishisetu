# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel / Vite)
# ==============================================================================
# Base URL of the FastAPI backend (no trailing slash).
# Local development default: http://localhost:8000
# Production (Vercel): https://your-krishisetu-backend.onrender.com
VITE_API_URL="http://localhost:8000"

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Render / FastAPI + PostgreSQL)
# ==============================================================================
# PostgreSQL connection string (Render Managed PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krishisetu_db"

# JWT Secret Key for signing authentication tokens (generate a random 32+ char string in production)
SECRET_KEY="change_this_to_a_secure_random_production_secret_key"

# Comma-separated list of allowed CORS frontend origins (e.g., https://krishisetu.vercel.app,http://localhost:3000)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# FCFS Equipment Booking Confirmation Window (in hours)
BOOKING_CONFIRMATION_HOURS="24"

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_KRISHISETU12345"
RAZORPAY_KEY_SECRET="test_secret_krishisetu98765"

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

